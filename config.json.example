{
  "master_concurrency_limit": 25,
  "read_ahead_budget_mb": 256,
  "metadata_cache_size_mb": 50,
  "fuse_block_size_bytes": 1048576,
  "streaming_threshold_kb": 128,
  "log_level": "INFO",
  "attr_timeout_seconds": 1,
  "entry_timeout_seconds": 1,
  "negative_timeout_seconds": 0,
  "fuse_max_inflight_mb": 0,
  "max_retry_attempts": 6,
  "retry_delay_ms": 500,
  "preload_workers_count": 4,
  "warm_start_idle_seconds": 6,
  "gostorm_url": "http://127.0.0.1:8090",
  "metrics_port": 9080,
  "physical_source_path": "/mnt/flodni-real",
  "fuse_mount_path": "/mnt/flodni-virtual",
  "disk_warmup_quota_gb": 15,
  "warmup_head_size_mb": 64,
  "warm_on_add": false,
  "warm_catchup_per_hour": 20,
  "warm_catchup_scope": "all",
  "played_protection_days": 90,
  "warmup_eviction_order": "written",
  "warm_next_episode": false,
  "warm_next_episode_same_torrent": false,
  "unconfirmed_read_margin_mb": 64,
  "refuse_unconfirmed_reads": false,
  "playback_webhook_warn_days": 7,
  "playback_keepalive_minutes": 15,
  "playback_keepalive_max_torrents": 4,
  "plex_path_map": {},
  "plex": {
    "url": "http://127.0.0.1:32400",
    "token": "",
    "library_id": 0
  }
}
