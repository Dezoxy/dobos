diff --git a/internal/anacrolix-torrent/request-strategy/stalldump.go b/internal/anacrolix-torrent/request-strategy/stalldump.go
new file mode 100644
index 0000000..00e9208
--- /dev/null
+++ b/internal/anacrolix-torrent/request-strategy/stalldump.go
@@ -0,0 +1,63 @@
+package requestStrategy
+
+import (
+	"sync"
+	"time"
+)
+
+// STALL-CAPTURE instrumentation (throwaway, never committed).
+
+type WalkedPiece struct {
+	Idx      int
+	Prio     int
+	Partial  bool
+	Deadline int64
+	Request  bool // piece.Request(): wanted (pending)
+	Returned bool // requestPiece callback accepted it for this peer
+}
+
+type ScanRecord struct {
+	At           time.Time
+	CapStart     int64
+	CapLeft      int64
+	StoppedByCap bool
+	NextIdx      int
+	NextPrio     int
+	Returned     int
+	Walked       []WalkedPiece
+}
+
+var (
+	scanMu    sync.Mutex
+	scanRing  [8]*ScanRecord
+	scanCount int
+	scanTotal int
+)
+
+func pushScan(r *ScanRecord) {
+	scanMu.Lock()
+	scanRing[scanCount%len(scanRing)] = r
+	scanCount++
+	scanMu.Unlock()
+}
+
+// LastScans returns the most recent scans, oldest first, plus the total count.
+func LastScans() ([]*ScanRecord, int) {
+	scanMu.Lock()
+	defer scanMu.Unlock()
+	var out []*ScanRecord
+	n := len(scanRing)
+	for i := scanCount - n; i < scanCount; i++ {
+		if i < 0 {
+			continue
+		}
+		out = append(out, scanRing[i%n])
+	}
+	return out, scanCount
+}
+
+// TreeState returns the state stored in the order tree for a key.
+func (me *PieceRequestOrder) TreeState(key PieceRequestOrderKey) (PieceRequestOrderState, bool) {
+	s, ok := me.keys[key]
+	return s, ok
+}
