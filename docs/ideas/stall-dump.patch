diff --git a/internal/gostorm/torr/stalldump.go b/internal/gostorm/torr/stalldump.go
new file mode 100644
index 0000000..f4c45e9
--- /dev/null
+++ b/internal/gostorm/torr/stalldump.go
@@ -0,0 +1,38 @@
+package torr
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"sync/atomic"
+	"time"
+)
+
+// STALL-CAPTURE instrumentation (throwaway, never committed).
+
+var stallDumps atomic.Int32
+
+// StallDumpOnTimeout dumps up to FLODNI_STALL_DUMP times (env integer) for the torrent.
+func StallDumpOnTimeout(hash string, what string) {
+	max, _ := strconv.Atoi(os.Getenv("FLODNI_STALL_DUMP"))
+	if max <= 0 {
+		return
+	}
+	n := stallDumps.Add(1)
+	if int(n) > max {
+		return
+	}
+	t := PeekTorrent(hash)
+	if t == nil || t.Torrent == nil {
+		return
+	}
+	out := func(s string) { fmt.Fprintf(os.Stderr, "[STALLDUMP#%d] %s\n", n, s) }
+	out(fmt.Sprintf("=== stall dump %d at %s (trigger: %s timeout, hash=%s) ===", n, time.Now().Format("15:04:05.000"), what, hash))
+	lo, hi := 0, 0
+	if t.cache != nil {
+		lo, hi = t.cache.StallDump(out)
+	}
+	t.Torrent.StallDump(lo, hi, out)
+	t.Torrent.StallPoke(os.Getenv("FLODNI_STALL_POKE") == "1", out)
+	out("=== end stall dump ===")
+}
diff --git a/internal/gostorm/torr/storage/torrstor/stalldump.go b/internal/gostorm/torr/storage/torrstor/stalldump.go
new file mode 100644
index 0000000..a9de06f
--- /dev/null
+++ b/internal/gostorm/torr/storage/torrstor/stalldump.go
@@ -0,0 +1,107 @@
+package torrstor
+
+import (
+	"fmt"
+	"sync/atomic"
+	"time"
+)
+
+// STALL-CAPTURE instrumentation (throwaway, never committed).
+
+// StallDump writes the cache's view and returns the piece window [lo, hi] to list in the engine.
+func (c *Cache) StallDump(out func(string)) (lo, hi int) {
+	now := time.Now()
+	lo, hi = 1<<30, -1
+	c.muReaders.RLock()
+	for r := range c.readers {
+		rng := r.getPiecesRange()
+		rp := r.getReaderPiece()
+		rah := r.getReaderRAHPiece()
+		r.mu.Lock()
+		inUse, inFlight, lastAccess, off, closed := r.isUse, r.inFlight, r.lastAccess, r.offset, r.isClosed
+		r.mu.Unlock()
+		out(fmt.Sprintf("cache reader %p: offset=%d readerPiece=%d readahead=%d raheadPiece=%d protectedRange=[%d,%d] isUse=%v inFlight=%d lastAccess=-%ds closed=%v rangeEnd=%d",
+			r, off, rp, atomic.LoadInt64(&r.readahead), rah, rng.Start, rng.End, inUse, inFlight, now.Unix()-lastAccess, closed, atomic.LoadInt64(&r.rangeEnd)))
+		if inUse {
+			if rp-2 < lo {
+				lo = rp - 2
+			}
+			if rah+2 > hi {
+				hi = rah + 2
+			}
+		}
+	}
+	c.muReaders.RUnlock()
+	if hi < 0 {
+		lo, hi = 0, c.pieceCount-1
+	}
+	if hi >= c.pieceCount {
+		hi = c.pieceCount - 1
+	}
+	if lo < 0 {
+		lo = 0
+	}
+	var total, complete, partial int64
+	var completeN, partialN int
+	var completeList, partialList []int
+	for id := 0; id < c.pieceCount; id++ {
+		p := c.pieces[id]
+		sz := atomic.LoadInt64(&p.Size)
+		if sz > 0 {
+			total += sz
+			if p.Complete.Load() {
+				complete += sz
+				completeN++
+				completeList = append(completeList, id)
+			} else {
+				partial += sz
+				partialN++
+				partialList = append(partialList, id)
+			}
+		}
+	}
+	out(fmt.Sprintf("cache: capacity=%d filled(atomic)=%d storedSumNow=%d (complete=%d in %d pieces, incomplete=%d in %d pieces) pieceLen=%d isRemove=%v lastCleanAge=%.1fs freeBuffers=%d activeReaders=%d readers=%d",
+		c.capacity, atomic.LoadInt64(&c.filled), total, complete, completeN, partial, partialN, c.pieceLength, c.isRemove.Load(),
+		now.Sub(time.Unix(0, c.lastCleanNS.Load())).Seconds(), len(c.free), c.activeReaders.Load(), len(c.readers)))
+	out(fmt.Sprintf("cache complete pieces with data: %v", completeList))
+	out(fmt.Sprintf("cache incomplete pieces with data: %v", partialList))
+	// would-evict analysis, without mutating anything
+	var ranges []Range
+	c.muReaders.RLock()
+	for r := range c.readers {
+		if r.isUse {
+			ranges = append(ranges, r.getPiecesRange())
+		}
+	}
+	c.muReaders.RUnlock()
+	ranges = mergeRange(ranges)
+	inRange := make([]bool, c.pieceCount)
+	fillPieceInRange(inRange, ranges, c.pieceCount)
+	evictable := 0
+	var evList []int
+	for id := 0; id < c.pieceCount; id++ {
+		p := c.pieces[id]
+		if pieceEvictable(atomic.LoadInt64(&p.Size), p.Complete.Load(), inRange[id]) && !c.isIdInFileBE(ranges, id) {
+			evictable++
+			evList = append(evList, id)
+		}
+	}
+	over := total > c.capacity
+	out(fmt.Sprintf("cache eviction: over capacity (stored>cap)=%v stored-cap=%d; evictable pieces now=%d %v; mergedRanges=%v; evict triggers only when filled>capacity strictly",
+		over, total-c.capacity, evictable, evList, ranges))
+	for id := lo; id <= hi; id++ {
+		p := c.pieces[id]
+		out(fmt.Sprintf("cache piece %d: Complete=%v Size=%d accessedAge=%ds inRange=%v inFileBE=%v localPrio=%v",
+			id, p.Complete.Load(), atomic.LoadInt64(&p.Size), now.Unix()-atomic.LoadInt64(&p.Accessed)/1, inRange[id], c.isIdInFileBE(ranges, id), c.localPriorityOf(id)))
+	}
+	return lo, hi
+}
+
+func (c *Cache) localPriorityOf(id int) interface{} {
+	c.muPriority.Lock()
+	defer c.muPriority.Unlock()
+	if v, ok := c.localPriority[id]; ok {
+		return v
+	}
+	return "-"
+}
