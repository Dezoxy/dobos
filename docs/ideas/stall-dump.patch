diff --git a/internal/anacrolix-torrent/stalldump.go b/internal/anacrolix-torrent/stalldump.go
new file mode 100644
index 0000000..fa7800a
--- /dev/null
+++ b/internal/anacrolix-torrent/stalldump.go
@@ -0,0 +1,273 @@
+package torrent
+
+import (
+	"fmt"
+	"os"
+	"runtime"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	request_strategy "github.com/anacrolix/torrent/request-strategy"
+)
+
+// STALL-CAPTURE instrumentation (throwaway, never committed).
+
+type updCall struct {
+	at     time.Time
+	peer   string
+	reason string
+	runN   int
+}
+
+type updRun struct {
+	at         time.Time
+	peer       string
+	reason     string
+	interested bool
+	desiredN   int
+}
+
+var (
+	dbgMu       sync.Mutex
+	dbgCalls    [64]updCall
+	dbgCallN    int
+	dbgRuns     [32]updRun
+	dbgRunN     int
+	dbgLastCall = map[*Peer]time.Time{}
+	dbgLastRun  = map[*Peer]updRun{}
+)
+
+func peerName(p *Peer) string {
+	if p == nil {
+		return "nil"
+	}
+	if p.RemoteAddr != nil {
+		return p.RemoteAddr.String()
+	}
+	return fmt.Sprintf("%p", p)
+}
+
+func recordUpdateCall(p *Peer, reason string) {
+	dbgMu.Lock()
+	dbgCalls[dbgCallN%len(dbgCalls)] = updCall{at: time.Now(), peer: peerName(p), reason: reason}
+	dbgCallN++
+	dbgLastCall[p] = time.Now()
+	dbgMu.Unlock()
+}
+
+func (t *Torrent) capStarveCheck(p *Peer, reason string) {
+	scans, _ := request_strategy.LastScans()
+	if len(scans) == 0 {
+		return
+	}
+	s := scans[len(scans)-1]
+	if s.StoppedByCap && s.Returned == 0 && !t._pendingPieces.IsEmpty() {
+		fmt.Fprintf(os.Stderr, "[CAPSTARVE] peer=%s reason=%q pending=%d nextIdx=%d nextPrio=%d walked=%d\n", peerName(p), reason, t._pendingPieces.GetCardinality(), s.NextIdx, s.NextPrio, len(s.Walked))
+	}
+}
+
+func recordUpdateRun(p *Peer, reason string, interested bool, n int) {
+	dbgMu.Lock()
+	r := updRun{at: time.Now(), peer: peerName(p), reason: reason, interested: interested, desiredN: n}
+	dbgRuns[dbgRunN%len(dbgRuns)] = r
+	dbgRunN++
+	dbgLastRun[p] = r
+	dbgMu.Unlock()
+}
+
+// StallDump writes the engine's view to out (one line per call). Pieces in [lo, hi] are listed.
+func (t *Torrent) StallDump(lo, hi int, out func(string)) {
+	got := make(chan struct{})
+	go func() {
+		t.cl.lock()
+		close(got)
+	}()
+	locked := true
+	select {
+	case <-got:
+	case <-time.After(3 * time.Second):
+		locked = false
+		out("engine: client lock NOT acquired in 3s, dumping unlocked (and the lock goroutine stays queued)")
+	}
+	if locked {
+		defer t.cl.unlock()
+	}
+	now := time.Now()
+	n := t.numPieces()
+	if lo < 0 {
+		lo = 0
+	}
+	if hi >= n {
+		hi = n - 1
+	}
+	out(fmt.Sprintf("engine: pieces=%d pieceLen=%d completed=%d pending=%d dataDownloadDisallowed=%v hasStorageCap=%v",
+		n, t.info.PieceLength, t.numPiecesCompleted(), t._pendingPieces.GetCardinality(), t.dataDownloadDisallowed.Bool(), t.hasStorageCap()))
+	for r := range t.readers {
+		out(fmt.Sprintf("engine reader: pos=%d off=%d len=%d readahead=%d pieces=[%d,%d) reading=%v responsive=%v",
+			r.pos, r.offset, r.length, r.readahead, r.pieces.begin, r.pieces.end, r.reading, r.responsive))
+	}
+	// pending set summary
+	var pend []string
+	t._pendingPieces.Iterate(func(x uint32) bool {
+		pend = append(pend, fmt.Sprint(x))
+		return true
+	})
+	out("engine pending pieces: " + strings.Join(pend, ","))
+	var compl []string
+	t._completedPieces.Iterate(func(x uint32) bool {
+		compl = append(compl, fmt.Sprint(x))
+		return true
+	})
+	out("engine completed pieces: " + strings.Join(compl, ","))
+	{
+		var own, pure []string
+		for i := 0; i < n; i++ {
+			pp := &t.pieces[i]
+			if pp.priority != PiecePriorityNone {
+				own = append(own, fmt.Sprintf("%d:%v(c=%v)", i, pp.priority, t.pieceComplete(i)))
+			}
+			if pp.purePriority() != PiecePriorityNone {
+				pure = append(pure, fmt.Sprintf("%d:%v(c=%v)", i, pp.purePriority(), t.pieceComplete(i)))
+			}
+		}
+		out("engine pieces with own priority set (idx:prio(complete)): " + strings.Join(own, " "))
+		out("engine pieces with effective priority (idx:prio(complete)): " + strings.Join(pure, " "))
+	}
+	for i := lo; i <= hi; i++ {
+		p := &t.pieces[i]
+		nch := int(p.numChunks())
+		var pendingChunks []string
+		undirty := 0
+		var reqPeers []string
+		for c := 0; c < nch; c++ {
+			ri := t.pieceRequestIndexOffset(i) + RequestIndex(c)
+			if !t.dirtyChunks.Contains(ri) {
+				undirty++
+				if rp := t.requestingPeer(ri); rp != nil {
+					reqPeers = append(reqPeers, fmt.Sprintf("%d@%s", c, peerName(rp)))
+				}
+			}
+		}
+		_ = pendingChunks
+		stc, stok := false, false
+		sc := p.Storage().Completion()
+		stc, stok = sc.Complete, sc.Ok
+		out(fmt.Sprintf("engine piece %d: complete=%v storageComplete=%v/ok=%v storageCompletionOk=%v pending=%v purePrio=%v ownPrio=%v deadline=%d partial=%v avail=%d undirtyChunks=%d/%d requestedChunks=%d hashing=%v marking=%v",
+			i, t.pieceComplete(i), stc, stok, p.storageCompletionOk, t._pendingPieces.Contains(uint32(i)),
+			p.purePriority(), p.priority, t.pieceDeadlines[i], t.piecePartiallyDownloaded(i), p.availability(),
+			undirty, nch, len(reqPeers), p.hashing, p.marking))
+	}
+	// order tree state for the window
+	if pro := t.getPieceRequestOrder(); pro != nil {
+		out(fmt.Sprintf("engine order tree len=%d", pro.Len()))
+		var stale []string
+		for i := 0; i < n; i++ {
+			ts, ok := pro.TreeState(t.pieceRequestOrderKey(i))
+			cur := t.requestStrategyPieceOrderState(i)
+			if !ok || ts != cur {
+				stale = append(stale, fmt.Sprintf("%d:tree{p%d,part=%v,av=%d,dl=%d}!=now{p%d,part=%v,av=%d,dl=%d}(c=%v)", i, ts.Priority, ts.Partial, ts.Availability, ts.Deadline, cur.Priority, cur.Partial, cur.Availability, cur.Deadline, t.pieceComplete(i)))
+			}
+		}
+		out(fmt.Sprintf("engine order tree entries differing from current piece state: %d: %s", len(stale), strings.Join(stale, " ")))
+	}
+	// scans
+	scans, total := request_strategy.LastScans()
+	out(fmt.Sprintf("engine request-order scans: total=%d, last %d follow (oldest first)", total, len(scans)))
+	for _, s := range scans {
+		var walked []string
+		var wantedWalked, completeWalked int
+		for _, w := range s.Walked {
+			walked = append(walked, fmt.Sprintf("%d(p%d%s%s)", w.Idx, w.Prio, map[bool]string{true: ",W", false: ",-"}[w.Request], map[bool]string{true: ",R", false: ""}[w.Returned]))
+			if w.Request {
+				wantedWalked++
+			} else {
+				completeWalked++
+			}
+		}
+		out(fmt.Sprintf("engine scan at -%.3fs: capStart=%d capLeft=%d stoppedByCap=%v nextIdx=%d nextPrio=%d walked=%d (wanted=%d notWanted=%d) returned=%d",
+			now.Sub(s.At).Seconds(), s.CapStart, s.CapLeft, s.StoppedByCap, s.NextIdx, s.NextPrio, len(s.Walked), wantedWalked, completeWalked, s.Returned))
+		out("engine scan walked (idx(prio,W=wanted/-=not,R=returned for peer)): " + strings.Join(walked, " "))
+	}
+	// peers
+	dbgMu.Lock()
+	defer dbgMu.Unlock()
+	t.iterPeers(func(p *Peer) {
+		lr := dbgLastRun[p]
+		lc := dbgLastCall[p]
+		out(fmt.Sprintf("engine peer %s: weInterested=%v peerChoking=%v peerInterested=%v requests=%d cancelled=%d needRequestUpdate=%q lastRequestUpdate=-%.1fs lastUpdateCall=-%.1fs lastRun={reason:%q interested:%v desired:%d at:-%.1fs} lastUsefulChunk=-%.1fs peerPieces=%d nominalMax=%d",
+			peerName(p), p.requestState.Interested, p.peerChoking, p.peerInterested,
+			p.requestState.Requests.GetCardinality(), p.requestState.Cancelled.GetCardinality(), p.needRequestUpdate,
+			since(now, p.lastRequestUpdate), since(now, lc), lr.reason, lr.interested, lr.desiredN, since(now, lr.at), since(now, p.lastUsefulChunkReceived),
+			peerPieceCount(p), int(p.nominalMaxRequests())))
+	})
+	// last update calls
+	type kv struct {
+		c updCall
+	}
+	var calls []updCall
+	for i := 0; i < len(dbgCalls) && i < dbgCallN; i++ {
+		calls = append(calls, dbgCalls[i])
+	}
+	sort.Slice(calls, func(i, j int) bool { return calls[i].at.Before(calls[j].at) })
+	out(fmt.Sprintf("engine updateRequests calls total=%d, last %d:", dbgCallN, len(calls)))
+	for _, c := range calls {
+		out(fmt.Sprintf("  call -%.2fs peer=%s reason=%q", now.Sub(c.at).Seconds(), c.peer, c.reason))
+	}
+	var runs []updRun
+	for i := 0; i < len(dbgRuns) && i < dbgRunN; i++ {
+		runs = append(runs, dbgRuns[i])
+	}
+	sort.Slice(runs, func(i, j int) bool { return runs[i].at.Before(runs[j].at) })
+	out(fmt.Sprintf("engine request-state runs total=%d, last %d:", dbgRunN, len(runs)))
+	for _, r := range runs {
+		out(fmt.Sprintf("  run -%.2fs peer=%s reason=%q desiredInterested=%v desiredRequests=%d", now.Sub(r.at).Seconds(), r.peer, r.reason, r.interested, r.desiredN))
+	}
+}
+
+func since(now, t time.Time) float64 {
+	if t.IsZero() {
+		return -1
+	}
+	return now.Sub(t).Seconds()
+}
+
+func peerPieceCount(p *Peer) int {
+	if pc, ok := p.peerImpl.(*PeerConn); ok {
+		return int(pc._peerPieces.GetCardinality())
+	}
+	return -1
+}
+
+// stallDryScan runs the request-order scan now (as a peer holding every piece would) and prints it.
+func (t *Torrent) stallDryScan(out func(string)) {
+	request_strategy.GetRequestablePieces(t.getRequestStrategyInput(), t.getPieceRequestOrder(),
+		func(ih InfoHash, pieceIndex int, st request_strategy.PieceRequestOrderState) bool { return true })
+	scans, _ := request_strategy.LastScans()
+	s := scans[len(scans)-1]
+	var walked []string
+	for _, w := range s.Walked {
+		walked = append(walked, fmt.Sprintf("%d(p%d%s%s)", w.Idx, w.Prio, map[bool]string{true: ",W", false: ",-"}[w.Request], map[bool]string{true: ",R", false: ""}[w.Returned]))
+	}
+	out(fmt.Sprintf("DRY SCAN NOW: capLeft=%d stoppedByCap=%v nextIdx=%d walked=%d returned=%d", s.CapLeft, s.StoppedByCap, s.NextIdx, len(s.Walked), s.Returned))
+	out("DRY SCAN walked: " + strings.Join(walked, " "))
+}
+
+// StallPoke runs a dry scan under the client lock and, with poke, asks every peer to update requests.
+func (t *Torrent) StallPoke(poke bool, out func(string)) {
+	t.cl.lock()
+	defer t.cl.unlock()
+	t.stallDryScan(out)
+	if poke {
+		out("POKE: calling updateRequests on all peers")
+		t.iterPeers(func(p *Peer) { p.updateRequests("stalldump poke") })
+	}
+}
+
+
+func dbgPeerClosed(p *Peer) {
+	buf := make([]byte, 4096)
+	n := runtime.Stack(buf, false)
+	fmt.Fprintf(os.Stderr, "[PEERCLOSE] %s at %s requests=%d interested=%v lastUseful=%.1fs ago\n%s\n", peerName(p), time.Now().Format("15:04:05.000"), p.requestState.Requests.GetCardinality(), p.requestState.Interested, since(time.Now(), p.lastUsefulChunkReceived), buf[:n])
+}
